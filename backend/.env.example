APP_NAME=RE-SCHOOL API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Comma-separated values are supported.
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REPORT_IMAGE_BUCKET=report-images
MAX_UPLOAD_MB=5
SIGNED_URL_TTL_SECONDS=3600
DASHBOARD_DEFAULT_DAYS=30
DASHBOARD_MAX_RANGE_DAYS=365

# CAMIDE uses a real ONNX model by default. Enable mock mode explicitly for local UI testing only.
CAMIDE_MODEL_PATH=app/ml/models/waste_classifier.onnx
CAMIDE_MODEL_PROFILE=camide_4class
CAMIDE_MODEL_LABELS=organic,inorganic,b3,residual
CAMIDE_CONFIDENCE_THRESHOLD=0.55
CAMIDE_MODEL_VERSION=camide-v1
CAMIDE_MOCK_CLASSIFIER=false
CAMIDE_STORE_IMAGES=false
CAMIDE_IMAGE_BUCKET=waste-identification-images
CAMIDE_MAX_DIMENSION=6000
